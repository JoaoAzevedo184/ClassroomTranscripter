# ============================================================
# Classroom Transcripter — variáveis de ambiente
# ============================================================
# Copie este arquivo pra .env (que está no .gitignore) e preencha
# APENAS as variáveis das plataformas/providers que você usa.
#
# Setup interativo dos cookies da Udemy:
#   classroom-setup

# ════════════════════════════════════════════════════════════
# UDEMY
# ════════════════════════════════════════════════════════════
# Cookies do navegador (DevTools → Network → Request Headers → Cookie).
# Use aspas simples — a string contém aspas duplas internas.
# Veja docs/sources/udemy.md pra detalhes.
UDEMY_COOKIES='access_token=xxx; cf_clearance=yyy; client_id=zzz'

# ════════════════════════════════════════════════════════════
# DIO — Whisper local
# ════════════════════════════════════════════════════════════
# Requer: pip install 'classroom-transcripter[dio]' + ffmpeg no sistema.
# Veja docs/sources/dio.md pra detalhes.

# Pasta raiz padrão (pode ser sobrescrita por --video-dir)
DIO_VIDEO_DIR=./dio_videos

# Modelo Whisper: tiny | base | small | medium | large
# small = melhor equilíbrio qualidade/velocidade (recomendado)
WHISPER_MODEL=small

# Idioma falado nas aulas (código ISO: pt, en, es, ...)
WHISPER_LANGUAGE=pt

# ════════════════════════════════════════════════════════════
# ALURA
# ════════════════════════════════════════════════════════════
# ⚠️ Fase 7 entregue como esqueleto — veja docs/sources/alura.md.
# Use aspas simples na senha se tiver caracteres especiais.
ALURA_EMAIL=
ALURA_PASSWORD=

# ════════════════════════════════════════════════════════════
# IA Providers — escolha 1 ou mais pro `classroom-enrich`
# ════════════════════════════════════════════════════════════

# Groq — gratuito, ultra-rápido (recomendado pra começar)
# Obtenha em: https://console.groq.com
GROQ_API_KEY=

# Gemini — gratuito, sem cartão
# Obtenha em: https://aistudio.google.com
GEMINI_API_KEY=

# Claude (Anthropic) — pago, alta qualidade
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ollama — local, padrão http://localhost:11434
# Pra Ollama em outra máquina (homelab):
#   OLLAMA_URL=http://192.168.1.100:11434
OLLAMA_URL=http://localhost:11434

# ════════════════════════════════════════════════════════════
# Opções gerais
# ════════════════════════════════════════════════════════════

# Prioridade de idiomas pras legendas (Udemy/Alura)
# Default se não definido: pt,pt-BR,en,en_US,en_GB,es
LANG_PRIORITY=pt,en,es
